# Settings of the Thumbnail Generation API, with their default values.
#
# How to use it:
#   cp .env.example .env
# then change a value in .env. `make dev` and `make up` (docker compose) read .env. The app itself
# reads only real environment variables, so tests are never affected by this file.
#
# Every variable is listed, with the value the app uses when the variable is not set.
# The full reference, with validation rules: src/app/settings.py.
# tests/test_env_example.py fails when a setting is missing here.
#
# Rules for values: no comment at the end of a line, and no "$" (docker compose would read it as
# a variable).


# ======================================================================================
# Where the service runs
# ======================================================================================

# Name of the deployment: local, development, staging or production.
# It is added to every log line and to every error sent to Sentry, so you can tell environments
# apart. It changes nothing else.
ENVIRONMENT=local


# ======================================================================================
# HTTP: path and browsers
# ======================================================================================

# Path prefix in front of every route, for example /api/thumbnail-generation in AWS, where the
# load balancer sends https://<host>/api/thumbnail-generation/... to this service without removing
# the prefix. The health check is then <BASE_PATH>/health. Leave empty to serve at /.
BASE_PATH=

# Web pages (origins) allowed to call this API from a browser on another host, as a JSON list.
# Example: a local core-web-app on http://localhost:3000 calling a deployed thumbnail service.
# nginx uses the same list for cached images. Not needed when the web app and the API are behind
# the same host.
WHITELISTED_CORS_URLS=["http://localhost:3000"]

# Same as above, but as one regular expression that must match the whole origin. The default
# allows a web app run on your own computer, on any port (http://localhost:3000, :5173, :8080...
# and the same on 127.0.0.1). This is safe: browsers send a bearer token, never cookies, so such
# a page still needs the user's own token. To allow a whole domain add for example
# https://.*[.]openbraininstitute[.]org to the pattern. Set it empty to allow only the list above.
CORS_ORIGIN_REGEX=http://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?


# ======================================================================================
# entitycore: where the files (morphologies, recordings, simulations) come from
# ======================================================================================

# Root URL of the entitycore API. The service asks it for an asset's details and downloads the
# file with the caller's token, so entitycore refuses a caller who may not read the asset.
ENTITY_CORE_URI=https://staging.openbraininstitute.org/api/entitycore

# How long, in seconds, one call to entitycore or one file download may take before the request
# fails with ENTITYCORE_UNAVAILABLE (503). Raise it if large files time out.
ENTITY_CORE_TIMEOUT_SECONDS=30

# How many connections one app process opens to entitycore and the file storage at the same time;
# more requests wait in the process. 200 calls at once made staging entitycore fail (502/503) for
# minutes, so a burst of thumbnails is passed on a few at a time.
ENTITY_CORE_MAX_CONNECTIONS=32

# Largest file, in bytes, the service downloads to draw (default 1 GiB = 1073741824). A larger file
# gets the error ASSET_TOO_LARGE instead of filling the memory: the container has 2 GB and a file
# is held in memory while it is read.
ENTITY_CORE_MAX_ASSET_BYTES=1073741824


# ======================================================================================
# Rendering
# ======================================================================================

# How many images one app process draws at the same time; the next requests wait their turn.
# Drawing uses CPU and memory (a parsed NWB file), so this keeps a burst of requests from using
# all of it. The image runs 2 app processes, so the container draws at most 2 x this number.
RENDER_CONCURRENCY=4

# How many files one app process downloads from entitycore at the same time; the next requests
# wait their turn. Keeps a burst (a grid scrolled to 200 thumbnails) from opening 200 connections
# to entitycore at once.
RENDER_DOWNLOADS=16

# Memory, in bytes, one app process may hold for the files it is drawing (each file counts 3 times
# its size: the file, its parsed data, the figure). A large file waits until enough is free. The
# image runs 2 app processes in a 2 GiB container, so 2 x 536870912 (512 MiB) leaves room for the
# rest. Without this limit, a burst of large ephys files filled the container's memory.
RENDER_MEMORY_BYTES=536870912


# ======================================================================================
# Sentry: error reporting
# ======================================================================================

# Address of the Sentry project that receives the errors of this service. Leave empty to send
# nothing (the usual choice on a laptop).
SENTRY_DSN=

# Share of requests, from 0 to 1, whose timing is sent to Sentry for performance charts
# (0.2 = one request in five). Used only when SENTRY_DSN is set.
SENTRY_TRACES_SAMPLE_RATE=0.2

# Share of requests, from 0 to 1, that are profiled (which functions took the time) for Sentry.
# Used only when SENTRY_DSN is set.
SENTRY_PROFILES_SAMPLE_RATE=0.05


# ======================================================================================
# Logs
# ======================================================================================

# Lowest level written: DEBUG, INFO, WARNING, ERROR or CRITICAL. Lines below it are dropped.
LOG_LEVEL=INFO

# How a log line looks. JSON: one JSON object per line, for CloudWatch or any log tool.
# CONSOLE: coloured and aligned, easy to read in a terminal. AUTO: CONSOLE in a terminal, JSON
# otherwise. The Docker image uses JSON.
LOG_FORMAT=AUTO

# Turn on DEBUG lines for some parts only, by name. Examples: * (everything), http.entitycore
# (each call to entitycore with its duration), *,-api.request (everything but the request lines).
# Leave empty to use LOG_LEVEL for all.
LOG_DEBUG=


# ======================================================================================
# Runtime (read by a library, not by settings.py)
# ======================================================================================

# Folder where matplotlib keeps its font cache. It must be writable: the production container has a
# read-only disk except /tmp, so the Docker image sets /tmp/matplotlib.
MPLCONFIGDIR=/tmp/matplotlib


# ======================================================================================
# Local tools only (make up / docker compose; not used in production)
# ======================================================================================

# Port on your laptop where the service answers, through nginx and its cache:
# http://localhost:8003/docs
API_PORT=8003

# Port on your laptop of the cache dashboard (GoAccess): every request, whether nginx served it
# from the cache (HIT) or drew it (MISS), and the most asked images: http://localhost:7890
CACHE_UI_PORT=7890

# Name of the Docker image `make build` and `make up` create.
IMAGE=thumbnail-generation-api:local
