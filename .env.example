# Every setting with its default. Copy to .env (make dev and make up read it) and change values.
# Reference: src/app/settings.py. No comment at the end of a line, no "$" in a value.


# ---- Deployment ----

# local, development, staging or production. Added to every log line and Sentry event.
ENVIRONMENT=local


# ---- HTTP ----

# Path prefix of every route, for example /api/thumbnail-generation. Empty: served at /.
BASE_PATH=

# Browser origins allowed to call the API (CORS), as a JSON list. nginx uses the same list.
WHITELISTED_CORS_URLS=["http://localhost:3000"]

# One more allowed origin pattern, matching the whole origin. Empty (default): only the list above.
# Local, for localhost on any port: http://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?
CORS_ORIGIN_REGEX=


# ---- entitycore (where the files come from) ----

# Root URL of the entitycore API. Files are read with the caller's token.
ENTITY_CORE_URI=https://staging.openbraininstitute.org/api/entitycore

# Seconds one step of a call (connect, read, write) may take before ENTITYCORE_UNAVAILABLE (503).
ENTITY_CORE_TIMEOUT_SECONDS=30

# Seconds one whole file download may take (503 after). Below nginx's 120 s proxy_read_timeout.
ENTITY_CORE_DOWNLOAD_SECONDS=60

# Connections one app process opens to entitycore and storage at once. Protects entitycore.
ENTITY_CORE_MAX_CONNECTIONS=32

# Largest file drawn, in bytes; at most RENDER_MEMORY_BYTES / 3. Larger: ASSET_TOO_LARGE.
# Empty (default): RENDER_MEMORY_BYTES / 3.
ENTITY_CORE_MAX_ASSET_BYTES=


# ---- Rendering (per app process; the image runs 2) ----

# Images drawn at the same time.
RENDER_CONCURRENCY=4

# Files downloaded at the same time.
RENDER_DOWNLOADS=16

# Bytes of files held while drawing (each counts 3x its size). 512 MiB suits a 2 GiB container.
RENDER_MEMORY_BYTES=536870912


# ---- Sentry ----

# Sentry project address. Empty: nothing is sent.
SENTRY_DSN=

# Share of requests (0 to 1) whose timing is sent.
SENTRY_TRACES_SAMPLE_RATE=0.2

# Share of requests (0 to 1) that are profiled.
SENTRY_PROFILES_SAMPLE_RATE=0.05


# ---- Logs ----

# Lowest level written: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# JSON (one object per line), CONSOLE (readable) or AUTO (CONSOLE in a terminal). The image uses JSON.
LOG_FORMAT=AUTO

# DEBUG for some loggers only, by name: * (all), http.entitycore, *,-api.request. Empty: LOG_LEVEL.
LOG_DEBUG=


# ---- Runtime (read by a library) ----

# matplotlib's font cache; must be writable (the container's root is read-only).
MPLCONFIGDIR=/tmp/matplotlib


# ---- Local tools only (make up) ----

# The API through nginx: http://localhost:8003/docs
API_PORT=8003

# The cache dashboard: http://localhost:7890
CACHE_UI_PORT=7890

# Docker image name built by make build and make up.
IMAGE=thumbnail-generation-api:local
